package ui

import "reno/internal/session"

// ---------- Rooms ----------

type RoomRow struct {
	ID   string
	Name string
	Type string
}

templ RoomsPage(user *session.User, project Project, rooms []RoomRow, errorMsg string) {
	@Layout(project.Name+" · Rooms", user, &ProjectNav{ID: project.ID, Name: project.Name}) {
		<h1 class="text-2xl font-bold mb-6">Rooms & areas</h1>
		<div class="grid gap-6 lg:grid-cols-3">
			<div class="lg:col-span-2 grid gap-3 sm:grid-cols-2">
				if len(rooms) == 0 {
					<div class="rounded-lg bg-white p-10 text-center shadow sm:col-span-2">
						<p class="text-stone-500">No rooms yet. Adding rooms (Kitchen, Primary bathroom, Exterior front…) lets you organize photos, materials, and costs by location.</p>
					</div>
				}
				for _, r := range rooms {
					<div class="rounded-lg bg-white p-4 shadow flex items-center justify-between">
						<div>
							<p class="font-medium">{ r.Name }</p>
							<p class="text-xs uppercase tracking-wide text-stone-400">{ r.Type }</p>
						</div>
						if canEdit(project.Role) {
							<form hx-post={ templ.URL("/rooms/" + r.ID + "/delete") } hx-confirm="Delete this room?">
								<button class="text-xs text-red-500 underline hover:text-red-700" type="submit">Delete</button>
							</form>
						}
					</div>
				}
			</div>
			if canEdit(project.Role) {
				<form class="space-y-3 rounded-lg bg-white p-5 shadow h-fit" method="post" action={ templ.URL("/projects/" + project.ID + "/rooms") }>
					<h2 class="font-semibold">Add room / area</h2>
					<input class="w-full rounded border border-stone-300 px-3 py-2 text-sm" name="name" placeholder="Name (e.g. Kitchen)" required/>
					<select class="w-full rounded border border-stone-300 px-3 py-2 text-sm" name="type">
						<option value="interior">Interior</option>
						<option value="exterior">Exterior</option>
						<option value="other">Other</option>
					</select>
					@ErrorBanner(errorMsg)
					<button class="rounded bg-amber-500 hover:bg-amber-400 font-semibold px-4 py-2 text-sm" type="submit">Add</button>
				</form>
			}
		</div>
	}
}

// ---------- Photos ----------

type PhotoCard struct {
	ID       string
	URL      string
	Caption  string
	Stage    string
	Room     string
	Taken    string
}

func photoStageLabel(s string) string {
	switch s {
	case "before":
		return "Before"
	case "during":
		return "During"
	case "after":
		return "After"
	case "damage":
		return "Damage"
	case "measurement":
		return "Measurement"
	case "inspiration":
		return "Inspiration"
	case "product":
		return "Product"
	case "progress":
		return "Progress"
	}
	return s
}

templ PhotosPage(user *session.User, project Project, photos []PhotoCard, rooms []RoomRow, stage string, roomID string, errorMsg string) {
	@Layout(project.Name+" · Photos", user, &ProjectNav{ID: project.ID, Name: project.Name}) {
		<div class="flex flex-wrap items-center justify-between gap-3 mb-6">
			<h1 class="text-2xl font-bold">Photos</h1>
			<div class="flex flex-wrap gap-2 text-sm">
				<a class={ filterChipClass(stage == "" && roomID == "") } href={ templ.URL("/projects/" + project.ID + "/photos") }>All</a>
				{{ stages := []string{"before", "during", "after", "damage", "measurement", "inspiration", "product", "progress"} }}
				for _, s := range stages {
					<a class={ filterChipClass(stage == s) } href={ templ.URL("/projects/" + project.ID + "/photos?stage=" + s) }>{ photoStageLabel(s) }</a>
				}
				for _, r := range rooms {
					<a class={ filterChipClass(roomID == r.ID) } href={ templ.URL("/projects/" + project.ID + "/photos?room=" + r.ID) }>{ r.Name }</a>
				}
			</div>
		</div>

		if len(photos) == 0 {
			<div class="rounded-lg bg-white p-10 text-center shadow">
				<p class="text-stone-500">
							if stage != "" || roomID != "" {
								No photos for this filter.
							} else {
								No photos yet. Upload before / during / after shots to document the project.
							}
						</p>
			</div>
		} else {
			<div class="grid gap-4 grid-cols-2 md:grid-cols-3 lg:grid-cols-4">
				for _, ph := range photos {
					<figure class="overflow-hidden rounded-lg bg-white shadow">
						<a href={ templ.URL(ph.URL) } target="_blank" rel="noopener">
							<img class="aspect-[4/3] w-full object-cover" src={ templ.URL(ph.URL + "?thumb=400x300") } alt={ ph.Caption } loading="lazy"/>
						</a>
						<figcaption class="p-3 text-sm">
							if ph.Caption != "" {
								<p class="font-medium truncate">{ ph.Caption }</p>
							}
							<div class="mt-1 flex items-center gap-2 text-xs text-stone-400">
								<span class="rounded-full bg-amber-100 text-amber-800 px-2 py-0.5">{ photoStageLabel(ph.Stage) }</span>
								if ph.Room != "" {
									<span>{ ph.Room }</span>
								}
								if ph.Taken != "" {
									<span class="ml-auto">{ ph.Taken }</span>
								}
							</div>
							if canEdit(project.Role) {
								<form class="mt-2" hx-post={ templ.URL("/photos/" + ph.ID + "/delete") } hx-confirm="Delete this photo?">
									<button class="text-xs text-red-500 underline hover:text-red-700" type="submit">Delete</button>
								</form>
							}
						</figcaption>
					</figure>
				}
			</div>
		}

		if canEdit(project.Role) {
			<form class="mt-8 max-w-xl space-y-3 rounded-lg bg-white p-5 shadow" method="post" action={ templ.URL("/projects/" + project.ID + "/photos") } enctype="multipart/form-data">
				<h2 class="font-semibold">Upload photo</h2>
				<input class="w-full text-sm" type="file" name="image" accept="image/*" required/>
				<input class="w-full rounded border border-stone-300 px-3 py-2 text-sm" type="text" name="caption" placeholder="Caption"/>
				<div class="grid grid-cols-2 gap-3">
					<select class="rounded border border-stone-300 px-3 py-2 text-sm" name="stage">
						{{ formStages := []string{"before", "during", "after", "damage", "measurement", "inspiration", "product", "progress"} }}
						for _, s := range formStages {
							<option value={ s }>{ photoStageLabel(s) }</option>
						}
					</select>
					<select class="rounded border border-stone-300 px-3 py-2 text-sm" name="room">
						<option value="">Room…</option>
						for _, r := range rooms {
							<option value={ r.ID }>{ r.Name }</option>
						}
					</select>
				</div>
				<input class="w-full rounded border border-stone-300 px-3 py-2 text-sm" type="date" name="taken_date" title="Date taken"/>
				@ErrorBanner(errorMsg)
				<button class="rounded bg-amber-500 hover:bg-amber-400 font-semibold px-4 py-2 text-sm" type="submit">Upload</button>
			</form>
		}
	}
}

func filterChipClass(active bool) string {
	if active {
		return "rounded-full bg-stone-900 text-white px-3 py-1"
	}
	return "rounded-full bg-white border border-stone-300 px-3 py-1 hover:bg-stone-50"
}

// ---------- Documents ----------

type DocRow struct {
	ID       string
	Title    string
	Filename string
	URL      string
	Category string
	Date     string
}

templ DocumentsPage(user *session.User, project Project, docs []DocRow, errorMsg string) {
	@Layout(project.Name+" · Documents", user, &ProjectNav{ID: project.ID, Name: project.Name}) {
		<h1 class="text-2xl font-bold mb-6">Documents</h1>
		<div class="overflow-x-auto rounded-lg bg-white shadow mb-6">
			<table class="w-full text-sm">
				<thead>
					<tr class="border-b border-stone-200 text-left text-xs uppercase tracking-wide text-stone-500">
						<th class="px-3 py-2">Document</th>
						<th class="px-3 py-2">Category</th>
						<th class="px-3 py-2">Date</th>
						<th></th>
					</tr>
				</thead>
				<tbody class="divide-y divide-stone-100">
					if len(docs) == 0 {
						<tr><td class="px-3 py-8 text-center text-stone-500" colspan="4">No documents yet. Contracts, estimates, receipts, permits…</td></tr>
					}
					for _, d := range docs {
						<tr class="hover:bg-stone-50">
							<td class="px-3 py-2">
								<a class="font-medium text-amber-700 underline" href={ templ.URL(d.URL) } target="_blank" rel="noopener">{ docTitleOr(d) }</a>
							</td>
							<td class="px-3 py-2"><span class="rounded-full bg-stone-100 px-2 py-0.5 text-xs">{ d.Category }</span></td>
							<td class="px-3 py-2 text-stone-500">{ d.Date }</td>
							<td class="px-3 py-2 text-right">
								if canEdit(project.Role) {
									<form hx-post={ templ.URL("/documents/" + d.ID + "/delete") } hx-confirm="Delete this document?">
										<button class="text-xs text-red-500 underline hover:text-red-700" type="submit">Delete</button>
									</form>
								}
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>

		if canEdit(project.Role) {
			<form class="max-w-xl grid gap-3 sm:grid-cols-2 rounded-lg bg-white p-5 shadow" method="post" action={ templ.URL("/projects/" + project.ID + "/documents") } enctype="multipart/form-data">
				<h2 class="font-semibold sm:col-span-2">Upload document</h2>
				<input class="w-full text-sm sm:col-span-2" type="file" name="file" required/>
				<input class="rounded border border-stone-300 px-3 py-2 text-sm" type="text" name="title" placeholder="Title (optional)"/>
				<select class="rounded border border-stone-300 px-3 py-2 text-sm" name="category">
					<option value="contract">Contract</option>
					<option value="estimate">Estimate</option>
					<option value="receipt">Receipt</option>
					<option value="invoice">Invoice</option>
					<option value="permit">Permit</option>
					<option value="drawing">Drawing</option>
					<option value="brochure">Brochure</option>
					<option value="spec">Spec</option>
					<option value="warranty">Warranty</option>
					<option value="installation">Installation</option>
					<option value="other">Other</option>
				</select>
				<input class="rounded border border-stone-300 px-3 py-2 text-sm" type="date" name="doc_date" title="Document date"/>
				@ErrorBanner(errorMsg)
				<button class="rounded bg-amber-500 hover:bg-amber-400 font-semibold px-4 py-2 text-sm" type="submit">Upload</button>
			</form>
		}
	}
}

func docTitleOr(d DocRow) string {
	if d.Title != "" {
		return d.Title
	}
	return d.Filename
}
